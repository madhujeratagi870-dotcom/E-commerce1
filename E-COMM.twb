      <column caption='order day type' datatype='string' name='[Calculation_1141381076402610176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;,[order_purchase_timestamp]) = 1&#13;&#10;OR DATEPART(&apos;weekday&apos;,[order_purchase_timestamp]) = 7&#13;&#10;THEN &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='SHIPPING DAY' datatype='integer' name='[Calculation_1378383007565590529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,&#13;&#10;[order_purchase_timestamp],&#13;&#10;[order_delivered_customer_date])' />
      </column>
